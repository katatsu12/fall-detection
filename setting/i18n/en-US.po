msgid "section.contact"
msgstr "Emergency contact"

msgid "contact.name"
msgstr "Name"

msgid "contact.name_placeholder"
msgstr "e.g. Anna Reyes"

msgid "contact.phone"
msgstr "Phone"

msgid "contact.phone_placeholder"
msgstr "+1 555 0100"

msgid "contact.help"
msgstr "During the countdown the watch says \"We'll call {name}, then emergency services\". The call itself is placed by your webhook relay."

msgid "section.delivery"
msgstr "Alert delivery"

msgid "delivery.url"
msgstr "Webhook URL"

msgid "delivery.url_placeholder"
msgstr "https://example.com/sos"

msgid "delivery.token"
msgstr "Bearer token (optional)"

msgid "delivery.help"
msgstr "When the wearer doesn't respond, the phone POSTs a JSON alert here. Point it at a relay (Twilio Function, Cloud Function, Make) that calls the contact and then emergency services."

msgid "delivery.test"
msgstr "Send test alert"

msgid "delivery.testing"
msgstr "Sending…"

msgid "delivery.test_ok"
msgstr "Delivered (HTTP {status})"

msgid "delivery.test_fail"
msgstr "Failed: {error}"

msgid "delivery.no_url"
msgstr "Enter a webhook URL first."

msgid "section.watch"
msgstr "On the watch"

msgid "watch.help"
msgstr "Sensitivity and the siren are set on the watch: swipe up on the Fall Guard home screen."

msgid "section.developer"
msgstr "Developer"

msgid "developer.record_url"
msgstr "Recordings URL"

msgid "developer.record_url_placeholder"
msgstr "http://192.168.1.20:8787/recording"

msgid "developer.help"
msgstr "Debug builds record motion around every hard impact and send the files here (npm run webhook on your computer). Leave empty to keep them on the watch."
